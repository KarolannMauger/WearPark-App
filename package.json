{
  "name": "wearpark-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "dev": "cross-env ENV_FILE=.env.development expo start",
    "dev-tunnel": "cross-env ENV_FILE=.env.development expo start --tunnel",
    "dev:android": "cross-env ENV_FILE=.env.development expo start --android",
    "dev:ios": "cross-env ENV_FILE=.env.development expo start --ios",
    "env:test": "cross-env ENV_FILE=.env.test expo start",
    "env:test:android": "cross-env ENV_FILE=.env.test expo start --android",
    "env:test:ios": "cross-env ENV_FILE=.env.test expo start --ios",
    "prod:preview": "cross-env ENV_FILE=.env.production expo start",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@expo-google-fonts/roboto": "^0.4.2",
    "@expo-google-fonts/work-sans": "^0.4.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-picker/picker": "2.11.1",
    "axios": "^1.13.4",
    "base64-js": "^1.5.1",
    "expo": "~54.0.33",
    "expo-checkbox": "~5.0.8",
    "expo-constants": "~18.0.13",
    "expo-file-system": "^55.0.19",
    "expo-font": "~14.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "^55.0.18",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-calendars": "^1.1314.0",
    "react-native-gifted-charts": "^1.4.74",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/base64-js": "^1.3.2",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.1.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.3",
    "jest": "^29.7.0",
    "jest-expo": "^54.0.3",
    "jest-websocket-mock": "^2.5.0",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
